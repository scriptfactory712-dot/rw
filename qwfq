if State.HealthBar then
local hbBg = bb:FindFirstChild("HealthBarBg")
if hbBg then
hbBg.Visible = true
local hb = hbBg:FindFirstChild("HealthBar")
if hb and hum then
local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
hb.Size = UDim2.fromScale(pct, 1)
hb.BackgroundColor3 = Color3.fromRGB(255 * (1 - pct), 255 * pct, 0)
end
end
else
local hbBg = bb:FindFirstChild("HealthBarBg")
if hbBg then hbBg.Visible = false end
end
end
end
else
if p.Character then
for _, d in ipairs(p.Character:GetDescendants()) do
if d.Name == "Rivals_NameTag" then pcall(function() d:Destroy() end) end
end
end
end
else
if espObjects[p] then
pcall(function() espObjects[p]:Destroy() end)
espObjects[p] = nil
end
if p.Character then
for _, d in ipairs(p.Character:GetDescendants()) do
if d.Name == "Rivals_NameTag" then pcall(function() d:Destroy() end) end
end
end
end
end
