local function isEnemy(p)
if p == LocalPlayer then return false end
if not State.TeamCheck then return true end
if LocalPlayer.Team and p.Team then
return LocalPlayer.Team ~= p.Team
end
return true
end
local function hasWeapon()
if not Character then return false end
for _, t in ipairs(Character:GetChildren()) do
if t:IsA("Tool") then return true end
end
local bp = LocalPlayer:FindFirstChild("Backpack")
if bp then
for _, t in ipairs(bp:GetChildren()) do
if t:IsA("Tool") then return true end
end
end
return false
end
local function patchGuns()
local count = 0
local seen = {}
local containers = {LocalPlayer:FindFirstChild("Backpack"), Character, ReplicatedStorage}
for _, container in ipairs(containers) do
if container then
for _, obj in ipairs(container:GetDescendants()) do
if not seen[obj] then
seen[obj] = true
if obj:IsA("NumberValue") or obj:IsA("IntValue") then
local n = obj.Name:lower()
if State.NoRecoil and (n:find("recoil") or n:find("kick") or n:find("sway")) then
local ok = pcall(function() obj.Value = 0 end)
if ok then count = count + 1 end
elseif State.NoSpread and (n:find("spread") or n:find("bloom") or n:find("deviation")) then
local ok = pcall(function() obj.Value = 0 end)
if ok then count = count + 1 end
elseif n:find("accuracy") then
local ok = pcall(function() obj.Value = 100 end)
if ok then count = count + 1 end
end
end
if obj:IsA("Tool") then
for _, attr in ipairs({"Recoil","Spread","MaxSpread","MinSpread","Bloom","Deviation","Kickback","RecoilAmount","Sway","Accuracy"}) do
local ok = pcall(function()
if attr == "Accuracy" then
obj:SetAttribute(attr, 100)
else
obj:SetAttribute(attr, 0)
end
end)
if ok then count = count + 1 end
end
end
end
end
end
end
notify("Weapon Mods", "Patched " .. count .. " values")
end
