local lbl = bb:FindFirstChild("Label")
if lbl then
local hum = p.Character:FindFirstChild("Humanoid")
local dist = RootPart and head.Position and (head.Position - RootPart.Position).Magnitude or 0
lbl.Text = p.Name .. " [" .. math.floor(dist) .. "m]" .. (hum and (" HP:" .. math.floor(hum.Health)) or "")
